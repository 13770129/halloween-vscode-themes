  "tokenColors": [
    {
      "scope": "",
      "settings": {
        "foreground": "#d9fff8"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#ffd23d"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#a8ff3d"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#00e5c8"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#00e5c8"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#b2c6a6"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#ffd23d"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#d9fff8"
      }
    },
    {
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#ffd23d"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#b2c6a6"
      }
    },
    {
