        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#a8ff3d"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#00e5c8"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#a8ff3d"
      }
