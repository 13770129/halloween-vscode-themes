  "tokenColors": [
    {
      "scope": "",
      "settings": {
        "foreground": "#0c1442"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#898faa",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#856400"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#8b2fd1"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#c8102e"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#2f45d6"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#2f45d6"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#56596c"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#856400"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#c8102e"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#0c1442"
      }
    },
    {
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#856400"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#56596c"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#007fa8"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#8b2fd1"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#2f45d6"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#8b2fd1"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#2f45d6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#898faa",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#856400",
        "fontStyle": "underline"
      }
    }
  ]
}
