  "tokenColors": [
    {
      "scope": "",
      "settings": {
        "foreground": "#2b1a05"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#a88f6a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#8f6a00"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#6e5a3a"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#c9a000"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#b8520a"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#b8520a"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#7a5a2c"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#8f6a00"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#c9a000"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#2b1a05"
      }
    },
    {
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#8f6a00"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#7a5a2c"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#d07a1a"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#6e5a3a"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#b8520a"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#6e5a3a"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#b8520a",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#a88f6a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#8f6a00",
        "fontStyle": "underline"
      }
    }
  ]
}
