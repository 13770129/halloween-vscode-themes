  "tokenColors": [
    {
      "scope": "",
      "settings": {
        "foreground": "#33061f"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#a8869a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#0d7d60"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#e86aa8"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#a88a00"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#c2187a"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#c2187a"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#7d4766"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#0d7d60"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#a88a00"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#33061f"
      }
    },
    {
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#0d7d60"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#7d4766"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#7a4fd1"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#e86aa8"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#c2187a"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#e86aa8"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#c2187a",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#a8869a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#0d7d60",
        "fontStyle": "underline"
      }
    }
  ]
}
