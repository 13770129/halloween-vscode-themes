  "tokenColors": [
    {
      "scope": "",
      "settings": {
        "foreground": "#04233a"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#8598a6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#c03f00"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#0a9e86"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#c8102e"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#0062a8"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#0062a8"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#585f67"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#c03f00"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#c8102e"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#04233a"
      }
    },
    {
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#c03f00"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#585f67"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#4f7590"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#0a9e86"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#0062a8"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#0a9e86"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#0062a8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#8598a6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#c03f00",
        "fontStyle": "underline"
      }
    }
  ]
}
