  "tokenColors": [
    {
      "scope": "",
      "settings": {
        "foreground": "#e0f3ff"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#677784",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#ff6a1a"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#2ee0c0"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#ff3d5a"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#3dbcff"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#3dbcff"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#b7aba6"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#ff6a1a"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#ff3d5a"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#e0f3ff"
      }
    },
    {
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#ff6a1a"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#b7aba6"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#cfeaff"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#2ee0c0"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#3dbcff"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#2ee0c0"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#3dbcff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#677784",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#ff6a1a",
        "fontStyle": "underline"
      }
    }
