  "tokenColors": [
    {
      "scope": "",
      "settings": {
        "foreground": "#3a1a00"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#a6917d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#3a7d00"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#7a2fe0"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#d1202e"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#b84800"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#b84800"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#6e5f3c"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#3a7d00"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#d1202e"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#3a1a00"
      }
    },
    {
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#3a7d00"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#6e5f3c"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#c48a00"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#7a2fe0"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#b84800"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#7a2fe0"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#b84800",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#a6917d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#3a7d00",
        "fontStyle": "underline"
      }
    }
  ]
}
