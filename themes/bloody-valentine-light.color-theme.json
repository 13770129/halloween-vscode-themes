  "tokenColors": [
    {
      "scope": "",
      "settings": {
        "foreground": "#3a0510"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#a6868c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#b0247a"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#d1550e"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#8b2fd1"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#c4001f"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#c4001f"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#7c4759"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#b0247a"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#8b2fd1"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#3a0510"
      }
    },
    {
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#b0247a"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#7c4759"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#6e5a64"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#d1550e"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#c4001f"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#d1550e"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#c4001f",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#a6868c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#b0247a",
        "fontStyle": "underline"
      }
    }
  ]
