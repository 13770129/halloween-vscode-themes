  "tokenColors": [
    {
      "scope": "",
      "settings": {
        "foreground": "#03302a"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#83a29d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#8a6000"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#4f8a00"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#c8102e"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#00756a"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#00756a"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#516c5c"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#8a6000"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#c8102e"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#03302a"
      }
    },
    {
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#8a6000"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#516c5c"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#1f5fc8"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#4f8a00"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#00756a"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#4f8a00"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#00756a",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#83a29d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#8a6000",
        "fontStyle": "underline"
      }
    }
  ]
}
