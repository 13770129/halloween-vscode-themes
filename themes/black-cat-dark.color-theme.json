  "tokenColors": [
    {
      "scope": "",
      "settings": {
        "foreground": "#f3eaff"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#726d79",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#dcb8ff"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#ff5cd6"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#b8b0c4"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#a259ff"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#a259ff"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#bdb1cb"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#dcb8ff"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#b8b0c4"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#f3eaff"
      }
    },
    {
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#dcb8ff"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#bdb1cb"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#7a5cff"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#ff5cd6"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#a259ff"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#ff5cd6"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#a259ff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#726d79",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#dcb8ff",
        "fontStyle": "underline"
      }
    }
