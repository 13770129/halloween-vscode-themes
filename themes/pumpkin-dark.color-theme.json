  "tokenColors": [
    {
      "scope": "",
      "settings": {
        "foreground": "#ffeedd"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#847365",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#8fe03a"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#b06bff"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#ff4a3d"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#ff7a00"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#ff7a00"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#bbbc91"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#8fe03a"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#ff4a3d"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#ffeedd"
      }
    },
    {
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#8fe03a"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#bbbc91"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#ffc21a"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#b06bff"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#ff7a00"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#b06bff"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#ff7a00",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#847365",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#8fe03a",
        "fontStyle": "underline"
      }
    }
