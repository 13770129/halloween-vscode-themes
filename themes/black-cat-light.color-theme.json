  "tokenColors": [
    {
      "scope": "",
      "settings": {
        "foreground": "#120a1c"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#8f8999",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#1c1028"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#b0128a"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#5c5470"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#6a1fd6"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#6a1fd6"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#4f4759"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#1c1028"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#5c5470"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#120a1c"
      }
    },
    {
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#1c1028"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#4f4759"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#4a3fd1"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#b0128a"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#6a1fd6"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#b0128a"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#6a1fd6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#8f8999",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#1c1028",
        "fontStyle": "underline"
      }
    }
  ]
}
