  "tokenColors": [
    {
      "scope": "",
      "settings": {
        "foreground": "#d6ffe6"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#c8ff1a"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#8fb8a0"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#00ff6a"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#00ff6a"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#b0aab2"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#8fb8a0"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#d6ffe6"
      }
    },
    {
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#b0aab2"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#1ad6ff"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#c8ff1a"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#00ff6a"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#c8ff1a"
