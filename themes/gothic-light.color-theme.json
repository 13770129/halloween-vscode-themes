  "tokenColors": [
    {
      "scope": "",
      "settings": {
        "foreground": "#1c1519"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#948a96",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#a3173f"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#7c3aed"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#3b3440"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#5b21b6"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#5b21b6"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#5f5560"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#a3173f"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#3b3440"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#1c1519"
      }
    },
    {
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#a3173f"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#5f5560"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#8a8094"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#7c3aed"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#5b21b6"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#7c3aed"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#5b21b6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#948a96",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#a3173f",
        "fontStyle": "underline"
      }
    }
  ]
