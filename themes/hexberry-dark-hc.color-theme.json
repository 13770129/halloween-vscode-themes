    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#ffb3d9"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#ffb3d9"
