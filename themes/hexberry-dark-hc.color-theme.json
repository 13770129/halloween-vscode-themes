  "tokenColors": [
    {
      "scope": "",
      "settings": {
        "foreground": "#ffe6f3"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#5ef0c0"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#ffb3d9"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#f2e86d"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#d79ac0"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#5ef0c0"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#f2e86d"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#ffe6f3"
      }
    },
    {
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#5ef0c0"
      }
    },
