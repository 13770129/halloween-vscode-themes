  "tokenColors": [
    {
      "scope": "",
      "settings": {
        "foreground": "#e3e8ff"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#ffe066"
      }
    },
    {
