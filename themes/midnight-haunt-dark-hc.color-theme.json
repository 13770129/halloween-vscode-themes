      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#b9b7b5"
      }
    },
    {
